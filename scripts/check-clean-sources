#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workspace_root="$(cd "$repo_root/.." && pwd)"

repositories=(
  "gateway:$repo_root"
  "scanner:$workspace_root/juno-scan"
  "addrgen:$workspace_root/juno-addrgen"
  "txbuild:$workspace_root/juno-txbuild"
  "txsign:$workspace_root/juno-txsign"
  "keys:$workspace_root/juno-keys"
  "sdk:$workspace_root/juno-exchange-sdk"
)

failed=0
for entry in "${repositories[@]}"; do
  label="${entry%%:*}"
  path="${entry#*:}"
  if ! git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "release E2E source is not a git repository: $label ($path)" >&2
    failed=1
    continue
  fi
  status="$(git -C "$path" status --porcelain=v1 --untracked-files=all)"
  if [[ -n "$status" ]]; then
    echo "release E2E source is dirty: $label ($path)" >&2
    printf '%s\n' "$status" >&2
    failed=1
  fi
done

if (( failed != 0 )); then
  echo "release E2E requires clean source repositories so the recorded commits match the tested binaries" >&2
  exit 1
fi

echo "release E2E source provenance: clean"
