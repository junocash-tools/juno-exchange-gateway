#!/usr/bin/env bash
set -euo pipefail

provenance="${1:-}"
sbom="${2:-}"
shift 2 || true
if [[ ! -f "$provenance" || ! -f "$sbom" || "$#" -eq 0 ]]; then
  echo "usage: $0 PROVENANCE_JSON SBOM_JSON PLATFORM [PLATFORM...]" >&2
  exit 2
fi

expected="$(printf '%s\n' "$@" | jq -Rsc 'split("\n") | map(select(length > 0)) | unique | sort')"
expected_repository="${ATTESTATION_REPOSITORY:-}"
expected_revision="${ATTESTATION_REVISION:-}"
expected_version="${ATTESTATION_VERSION:-}"

jq -e \
  --argjson expected "$expected" \
  --arg expected_repository "$expected_repository" \
  --arg expected_revision "$expected_revision" \
  --arg expected_version "$expected_version" '
  def platform_map:
    if (type == "object" and has("SLSA")) then
      if ($expected | length) == 1 then {($expected[0]): .} else {} end
    else . end;
  platform_map |
  (type == "object") and
  ((keys | sort) == $expected) and
  all(.[];
    ((.SLSA | type) == "object") and
    (((.SLSA.buildType // .SLSA.buildDefinition.buildType) | type) == "string") and
    ((.SLSA.buildType // .SLSA.buildDefinition.buildType) == "https://github.com/moby/buildkit/blob/master/docs/attestations/slsa-definitions.md") and
    (((.SLSA.materials // .SLSA.buildDefinition.resolvedDependencies) | type) == "array") and
    (((.SLSA.materials // .SLSA.buildDefinition.resolvedDependencies) | length) > 0) and
    all((.SLSA.materials // .SLSA.buildDefinition.resolvedDependencies)[];
      (type == "object") and
      (.uri | type == "string") and
      (.uri | length > 0) and
      (.digest | type == "object") and
      ((.digest | length) > 0)) and
    ((.SLSA.buildDefinition // {}) as $definition |
      ($definition.externalParameters.request.args // {}) as $args |
      ($expected_repository == "" or
        ($args["label:org.opencontainers.image.source"] == ("https://github.com/" + $expected_repository))) and
      ($expected_revision == "" or
        ($args["build-arg:REVISION"] == $expected_revision and
         $args["label:org.opencontainers.image.revision"] == $expected_revision)) and
      ($expected_version == "" or
        ($args["build-arg:VERSION"] == $expected_version and
         $args["label:org.opencontainers.image.version"] == $expected_version))))
' "$provenance" >/dev/null

jq -e --argjson expected "$expected" '
  def platform_map:
    if (type == "object" and has("SPDX")) then
      if ($expected | length) == 1 then {($expected[0]): .} else {} end
    else . end;
  platform_map |
  (type == "object") and
  ((keys | sort) == $expected) and
  all(.[];
    ((.SPDX | type) == "object") and
    ((.SPDX.spdxVersion | type) == "string") and
    (.SPDX.spdxVersion | test("^SPDX-[0-9]+(\\.[0-9]+)+$")) and
    ((.SPDX.packages | type) == "array") and
    ((.SPDX.packages | length) > 0) and
    all(.SPDX.packages[]; (type == "object") and (.name | type == "string") and (.name | length > 0)))
' "$sbom" >/dev/null
