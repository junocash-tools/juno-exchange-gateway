  '.events | any(.kind == "OutgoingOutputExpired"
    and .payload.txid == $txid
    and .payload.status.state == "expired"
    and .payload.expiry_height == $expiry)' \
  "scanner expiry event did not retain transaction expiry identity"
code="$(api_status GET "/v1/transactions/$expiry_txid?wallet_id=$wallet_id" "$run_dir/expiry-transaction-dropped.json")"
[[ "$code" == "200" ]] || fail "dropped expired transaction lookup must return terminal scanner state, got HTTP $code"
assert_jq "$run_dir/expiry-transaction-dropped.json" --arg txid "$expiry_txid" --argjson expiry "$expiry_height" \
  '.data.transaction.txid == $txid
    and .data.transaction.state == "expired"
    and .data.transaction.confirmations == 0
    and .data.transaction.expiry_height == $expiry
    and (.data.wallet_effects | last | .kind == "OutgoingOutputExpired")' \
  "dropped expired transaction did not return the final scanner lifecycle state"
wait_note_summary "$run_dir/note-summary-after-expiry.json" \
  '.data.as_of_scanner_height >= $height
    and .data.pending_spend.note_count == 0
    and .data.pending_spend.value_zat == 0
    and .data.pending_spend.known_expiry_count == 0
    and .data.pending_spend.next_expiry_height == null
    and .data.pending_spend.last_expiry_height == null' \
