    and .data.pending_spend.next_expiry_height == $expiry
    and .data.pending_spend.last_expiry_height == $expiry' \
  "note summary did not classify every expiry input with the transaction expiry" \
  --argjson expiry "$expiry_height"
expiry_pending_count="$(jq -er '.data.pending_spend.note_count' "$run_dir/note-summary-expiry-pending.json")"
