assert_no_deposit "$withdrawal_txid" "$run_dir/withdrawal-change-still-not-deposit.json"
wait_note_status "$run_dir/withdrawal-note-status-request.json" "$run_dir/withdrawal-notes-spend-confirmed.json" \
  '.data.statuses | all(.state == "spent"
    and .spent_txid == $txid
    and .spent_height == $height
    and (.spent_confirmed_height | type == "number")
    and .spent_confirmed_height >= .spent_height)' \
  "selected-note spend finality evidence was not recorded" \
  --arg txid "$withdrawal_txid" --argjson height "$withdrawal_block_height"
wait_coordinator_state "$withdrawal_attempt_id" final "$run_dir/withdrawal-coordinator-final.json" \
  || fail "coordinator did not finalize and release the confirmed note reservation"

