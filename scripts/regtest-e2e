  node "$workspace_root/juno-exchange-sdk/examples/get-wallet-balance.mjs" \
    >"$run_dir/sdk-wallet-balance.json"
assert_jq "$run_dir/sdk-wallet-balance.json" \
  --arg wallet "$wallet_id" \
  '.walletId == $wallet
    and .minConfirmations == 100
    and .minNoteZat == "0"
    and (.totalUnspent.valueZat | test("^(0|[1-9][0-9]*)$"))
    and ((.spendable.valueZat | tonumber) > 0)
    and (.asOfScannerHash | test("^[0-9a-f]{64}$"))' \
  "Node SDK wallet-wide balance response is invalid"

code="$(api_status GET "/v1/wallets/$wallet_id/deposits?limit=1" "$run_dir/deposits-page-1.json")"
