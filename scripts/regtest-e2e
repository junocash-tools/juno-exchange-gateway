  "first deposit page did not contain the detected lifecycle event"
assert_jq "$run_dir/deposits-page-2.json" --arg txid "$deposit_txid" --arg cursor "$cursor_page_1" \
  '.data.deposits[0].txid == $txid and .data.deposits[0].status == "confirmed" and .data.next_cursor != $cursor' \
  "second deposit page did not advance to the confirmed lifecycle event"
continuity_cursor="$(jq -er '.data.next_cursor' "$run_dir/deposits-page-2.json")"
continuity_epoch="$(jq -er '.data.event_epoch' "$run_dir/deposits-page-2.json")"
code="$(api_status GET "/v1/wallets/$wallet_id/deposits?limit=1&status=confirmed&cursor=$cursor_page_1" "$run_dir/deposits-filter-mismatch.json")"
[[ "$code" == "409" ]] || fail "cursor reuse under changed filters must return 409"
assert_jq "$run_dir/deposits-filter-mismatch.json" '.error.code == "cursor_filter_mismatch"' \
  "changed deposit filters returned the wrong cursor error"

log "Scanner restart: rotate event epoch and require explicit cursor reset"
"${compose[@]}" restart juno-scan >/dev/null
wait_ready "$run_dir/ready-after-ordinary-scanner-restart.json"
code="$(api_status GET "/v1/wallets/$wallet_id/deposits?limit=100&cursor=$continuity_cursor" "$run_dir/deposits-after-ordinary-scanner-restart.json")"
[[ "$code" == "409" ]] || fail "retained cursor after scanner restart must return 409, got HTTP $code"
assert_jq "$run_dir/deposits-after-ordinary-scanner-restart.json" --arg epoch "$continuity_epoch" \
  '.error.code == "cursor_reset_required"
    and .error.details.action == "restart_without_cursor"
    and .error.details.event_epoch != $epoch' \
  "ordinary scanner restart did not rotate the epoch with reset instructions"
code="$(api_status GET "/v1/wallets/$wallet_id/deposits?limit=100" "$run_dir/deposits-replayed-after-ordinary-restart.json")"
[[ "$code" == "200" ]] || fail "cursorless replay after scanner restart returned HTTP $code"
assert_jq "$run_dir/deposits-replayed-after-ordinary-restart.json" --arg txid "$deposit_txid" \
  '(.data.deposits | any(.txid == $txid and .status == "detected"))
    and (.data.deposits | any(.txid == $txid and .status == "confirmed"))
    and ([.data.deposits[] | select(.txid == $txid) | .deposit_id] | unique | length == 1)' \
  "cursorless replay after scanner restart skipped or changed the deposit identity"

log "E2E withdrawal: Node SDK creates signed raw hex through the private coordinator"
assert_regtest_nu62 "$run_dir/nu62-before-withdrawal-signing.json"
creation_idempotency_key="withdrawal-create-$(openssl rand -hex 8)"
JUNO_COORDINATOR_URL="$coordinator_url" \
JUNO_COORDINATOR_TOKEN="$coordinator_token" \
JUNO_NETWORK=regtest \
JUNO_WALLET_ID="$wallet_id" \
JUNO_IDEMPOTENCY_KEY="$creation_idempotency_key" \
  node "$workspace_root/juno-exchange-sdk/examples/create-raw-transaction.mjs" \
    withdrawal:e2e-1 \
    "$destination_address" \
    1000000 >"$run_dir/withdrawal-signed.json"
assert_jq "$run_dir/withdrawal-signed.json" \
  --arg wallet "$wallet_id" \
  '.walletId == $wallet
    and .approvalReference == "withdrawal:e2e-1"
    and .state == "signed"
    and (.attemptId | test("^txn_[0-9a-f]{32}$"))
    and (.txid | test("^[0-9a-f]{64}$"))
    and (.rawTxHex | test("^[0-9a-f]+$") and (length % 2 == 0))
    and .feeZat == "200000"
    and (.expiryHeight | type == "number")
    and (.planDigest | test("^sha256:[0-9a-f]{64}$"))
    and (.selectedNoteIds | length) > 0
    and (.orchardOutputActionIndices | length) == 1
    and (.changeAddress | startswith("jregtest1"))' \
  "Node SDK did not return a complete signed raw transaction"
withdrawal_attempt_id="$(jq -er '.attemptId' "$run_dir/withdrawal-signed.json")"
withdrawal_txid="$(jq -er '.txid' "$run_dir/withdrawal-signed.json")"
raw_tx="$(jq -er '.rawTxHex' "$run_dir/withdrawal-signed.json")"
change_address="$(jq -er '.changeAddress' "$run_dir/withdrawal-signed.json")"
withdrawal_expiry_height="$(jq -er '.expiryHeight' "$run_dir/withdrawal-signed.json")"
jq '{note_ids:.selectedNoteIds}' "$run_dir/withdrawal-signed.json" >"$run_dir/withdrawal-note-status-request.json"

JUNO_COORDINATOR_URL="$coordinator_url" \
JUNO_COORDINATOR_TOKEN="$coordinator_token" \
JUNO_NETWORK=regtest \
JUNO_WALLET_ID="$wallet_id" \
JUNO_IDEMPOTENCY_KEY="$creation_idempotency_key" \
  node "$workspace_root/juno-exchange-sdk/examples/create-raw-transaction.mjs" \
    withdrawal:e2e-1 \
    "$destination_address" \
    1000000 >"$run_dir/withdrawal-signed-replay.json"
assert_jq "$run_dir/withdrawal-signed-replay.json" \
  --slurpfile first "$run_dir/withdrawal-signed.json" \
  '.attemptId == $first[0].attemptId and .txid == $first[0].txid and .rawTxHex == $first[0].rawTxHex' \
  "Node SDK idempotent replay changed the signed transaction"
code="$(coordinator_api_status GET "/v1/transaction-attempts/$withdrawal_attempt_id" "$run_dir/withdrawal-coordinator-signed.json")"
[[ "$code" == "200" ]] || fail "signed coordinator attempt lookup returned HTTP $code"
assert_jq "$run_dir/withdrawal-coordinator-signed.json" \
  --arg txid "$withdrawal_txid" --arg change "$change_address" \
  '.data.state == "signed" and .data.txid == $txid and .data.change_address == $change' \
  "coordinator did not persist the signed attempt"

code="$(api_status POST "/v1/wallets/$wallet_id/notes/status" "$run_dir/withdrawal-notes-unspent.json" "$run_dir/withdrawal-note-status-request.json" "" "$treasury_token")"
[[ "$code" == "200" ]] || fail "pre-broadcast selected-note status returned HTTP $code"
assert_jq "$run_dir/withdrawal-notes-unspent.json" \
  --slurpfile request "$run_dir/withdrawal-note-status-request.json" \
  --slurpfile replay "$run_dir/deposits-replayed-after-ordinary-restart.json" \
  '(.data.statuses | map(.note_id)) == $request[0].note_ids
    and (.data.statuses | all(.state == "unspent" and (.source_height | type == "number") and (.value_zat | type == "number")))
    and (.data.event_epoch | test("^[0-9a-f]{64}$"))
    and .data.event_epoch == $replay[0].data.event_epoch
    and .data.as_of_scanner_height <= .data.as_of_node_height' \
  "selected notes were not all unspent before broadcast"

jq -n --arg note_id "$(printf 'f%.0s' {1..64}):4294967295" '{note_ids:[$note_id]}' >"$run_dir/unknown-note-status-request.json"
code="$(api_status POST "/v1/wallets/$wallet_id/notes/status" "$run_dir/unknown-note-status.json" "$run_dir/unknown-note-status-request.json" "" "$treasury_token")"
[[ "$code" == "200" ]] || fail "unknown selected-note status returned HTTP $code"
assert_jq "$run_dir/unknown-note-status.json" \
  '.data.statuses[0] as $item
    | (.data.statuses | length) == 1
      and $item.state == "unknown"
      and ($item | keys | sort) == ["note_id","state"]' \
  "unknown selected note did not fail closed without extra state fields"
code="$(api_status POST "/v1/wallets/$cold_wallet_id/notes/status" "$run_dir/note-status-cross-wallet.json" "$run_dir/withdrawal-note-status-request.json" "" "$treasury_token")"
[[ "$code" == "403" ]] || fail "treasury credential crossed its wallet grant for selected-note status"

dd if=/dev/zero of="$run_dir/note-status-oversize.bin" bs=1048577 count=1 status=none
code="$(api_status POST "/v1/wallets/$wallet_id/notes/status" "$run_dir/note-status-oversize.json" "$run_dir/note-status-oversize.bin" "" "$treasury_token")"
[[ "$code" == "413" ]] || fail "oversized selected-note status body returned HTTP $code instead of 413"

wrong_txid="$(printf '0%.0s' {1..64})"
jq -n --arg wallet "$wallet_id" --arg raw "$raw_tx" --arg txid "$wrong_txid" \
  '{wallet_id:$wallet,raw_tx_hex:$raw,expected_txid:$txid}' >"$run_dir/broadcast-wrong-request.json"
code="$(api_status POST /v1/transactions/broadcast "$run_dir/broadcast-wrong-response.json" "$run_dir/broadcast-wrong-request.json" "wrong-$(openssl rand -hex 8)" "$broadcast_token")"
[[ "$code" == "422" ]] || fail "wrong expected_txid must fail before broadcast, got HTTP $code"
assert_jq "$run_dir/broadcast-wrong-response.json" '.error.code == "expected_txid_mismatch"' \
  "wrong expected_txid returned the wrong error code"
node_cli getrawmempool >"$run_dir/mempool-after-wrong-txid.json"
assert_jq "$run_dir/mempool-after-wrong-txid.json" \
  --arg txid "$withdrawal_txid" 'index($txid) == null' \
  "wrong expected_txid still mutated the mempool"

jq -n --arg wallet "$wallet_id" --arg raw "$raw_tx" --arg txid "$withdrawal_txid" \
  '{wallet_id:$wallet,raw_tx_hex:$raw,expected_txid:$txid}' >"$run_dir/broadcast-request.json"
idempotency_key="withdrawal-$(openssl rand -hex 8)"
JUNO_GATEWAY_URL="$base_url" \
JUNO_GATEWAY_TOKEN="$broadcast_token" \
JUNO_WALLET_ID="$wallet_id" \
JUNO_BROADCAST_IDEMPOTENCY_KEY="$idempotency_key" \
  node "$workspace_root/juno-exchange-sdk/examples/broadcast-raw-transaction.mjs" \
    "$run_dir/withdrawal-signed.json" >"$run_dir/broadcast-accepted.json"
assert_jq "$run_dir/broadcast-accepted.json" \
  --arg wallet "$wallet_id" --arg txid "$withdrawal_txid" \
  '.walletId == $wallet and .txid == $txid and .accepted == true and .alreadyKnown == false' \
  "Node SDK broadcast acceptance response is invalid"

code="$(api_status POST /v1/transactions/broadcast "$run_dir/broadcast-replay.json" "$run_dir/broadcast-request.json" "$idempotency_key" "$broadcast_token")"
[[ "$code" == "200" ]] || fail "idempotent replay returned HTTP $code"
assert_jq "$run_dir/broadcast-replay.json" --arg txid "$withdrawal_txid" '.data.txid == $txid' \
  "idempotent replay changed transaction identity"
wait_coordinator_state "$withdrawal_attempt_id" broadcast "$run_dir/withdrawal-coordinator-broadcast.json" \
  || fail "coordinator did not observe the broadcast transaction"

code="$(api_status GET "/v1/transactions/$withdrawal_txid?wallet_id=$wallet_id&include_raw=true" "$run_dir/withdrawal-mempool.json")"
[[ "$code" == "200" ]] || fail "mempool lookup returned HTTP $code"
assert_jq "$run_dir/withdrawal-mempool.json" \
  --arg raw "$raw_tx" '.data.transaction.state == "mempool" and .data.transaction.raw_tx_hex == $raw' \
  "mempool/raw transaction lookup is invalid"

wait_wallet_registered_change_output "$wallet_id" "$read_token" "$withdrawal_txid" "$change_address" \
  "$run_dir/withdrawal-mempool-wallet-effects.json"
wait_note_summary "$run_dir/note-summary-pending-spend.json" \
  '.data.pending_spend.note_count > 0 and .data.pending_spend.value_zat > 0 and .data.pending_spend.known_expiry_count > 0' \
  "note summary did not classify scanner-observed pending inputs"
withdrawal_pending_count="$(jq -er '.data.pending_spend.note_count' "$run_dir/note-summary-pending-spend.json")"
withdrawal_pending_value="$(jq -er '.data.pending_spend.value_zat' "$run_dir/note-summary-pending-spend.json")"
wait_note_status "$run_dir/withdrawal-note-status-request.json" "$run_dir/withdrawal-notes-pending.json" \
  '.data.statuses | all(.state == "pending"
    and .pending_spent_txid == $txid
    and .pending_spent_expiry_height == $expiry
    and (.pending_spent_at | type == "string"))' \
  "selected notes did not become pending under the broadcast withdrawal" \
  --arg txid "$withdrawal_txid" --argjson expiry "$withdrawal_expiry_height"

node_cli generate 1 >"$run_dir/withdrawal-block.json"
withdrawal_block_hash="$(jq -er '.[0]' "$run_dir/withdrawal-block.json")"
withdrawal_block_height="$(node_cli getblockcount | jq -er '.')"
wait_ready "$run_dir/ready-withdrawal-mined.json"
wait_coordinator_state "$withdrawal_attempt_id" mined "$run_dir/withdrawal-coordinator-mined.json" \
  || fail "coordinator did not observe the mined transaction"
code="$(api_status GET "/v1/transactions/$withdrawal_txid?wallet_id=$wallet_id" "$run_dir/withdrawal-confirmed.json")"
[[ "$code" == "200" ]] || fail "confirmed lookup returned HTTP $code"
assert_jq "$run_dir/withdrawal-confirmed.json" \
  '.data.transaction.state == "confirmed" and .data.transaction.confirmations >= 1' \
  "withdrawal did not confirm"

wait_wallet_effect_kind "$wallet_id" "$read_token" "$withdrawal_txid" SpendEvent \
  "$run_dir/withdrawal-wallet-effects.json"
wait_note_summary "$run_dir/note-summary-withdrawal-mined.json" \
  '.data.as_of_scanner_height >= $height
    and .data.pending_spend.note_count == 0
    and .data.pending_spend.value_zat == 0
    and .data.pending_spend.known_expiry_count == 0
    and .data.pending_spend.next_expiry_height == null
    and .data.pending_spend.last_expiry_height == null' \
  "pending inputs did not clear after the withdrawal mined" \
  --argjson height "$withdrawal_block_height"
[[ "$withdrawal_pending_count" -gt 0 && "$withdrawal_pending_value" -gt 0 ]] || \
  fail "withdrawal pending-spend baseline was not positive"
wait_note_status "$run_dir/withdrawal-note-status-request.json" "$run_dir/withdrawal-notes-spent.json" \
  '.data.statuses | all(.state == "spent" and .spent_txid == $txid and .spent_height == $height)' \
  "selected notes did not bind to the mined withdrawal" \
  --arg txid "$withdrawal_txid" --argjson height "$withdrawal_block_height"
assert_jq "$run_dir/withdrawal-wallet-effects.json" \
  --arg txid "$withdrawal_txid" \
  --arg change "$change_address" \
  '(.data.wallet_effects | any(.kind == "SpendEvent" and .txid == $txid and .source_note.txid != null))
    and (.data.wallet_effects | any(.kind == "OutgoingOutputEvent"
      and .txid == $txid
      and .address == $change
      and .recipient_scope == "external"
      and .ovk_scope == "external"))
    and (.data.wallet_effects | all(has("payload") | not))
    and (.data.wallet_effects | all(has("note_nullifier") | not))' \
  "transaction lookup did not expose the spend and internal change effects"

wait_node_wallet_notified \
  "$withdrawal_block_height" \
  "$withdrawal_block_hash" \
  "$run_dir/withdrawal-node-wallet-notified.json"
destination_filter="$(jq -cn --arg address "$destination_address" '[$address]')"
node_cli z_listunspent 1 9999999 true "$destination_filter" >"$run_dir/destination-unspent.json"
