  "$run_dir/coordinator-expiry-state-broadcast.json" \
  || fail "coordinator did not observe the expiry-test broadcast"

"${compose[@]}" restart junocashd >/dev/null
wait_node
node_cli getrawmempool >"$run_dir/coordinator-expiry-mempool-after-restart.json"
assert_jq "$run_dir/coordinator-expiry-mempool-after-restart.json" \
  --arg txid "$coordinator_expiry_txid" \
  'index($txid) == null' \
  "persistmempool=0 restart did not drop the coordinator expiry transaction"

tip_height="$(node_cli getblockcount | jq -er '.')"
if (( tip_height > coordinator_expiry_height + 1 )); then
  fail "node passed the coordinator transaction expiry before its boundary check"
fi
blocks_after_expiry=$((coordinator_expiry_height + 1 - tip_height))
if (( blocks_after_expiry > 0 )); then
  node_cli generate "$blocks_after_expiry" >"$run_dir/coordinator-expiry-boundary-blocks.json"
fi
wait_ready "$run_dir/ready-after-coordinator-expiry.json"
wait_coordinator_state "$coordinator_expiry_attempt_id" expired_pending_reconciliation \
  "$run_dir/coordinator-expiry-state-pending.json" \
  || fail "coordinator did not keep the expired attempt locked for reconciliation"
assert_jq "$run_dir/coordinator-expiry-state-pending.json" \
  '.data.state == "expired_pending_reconciliation" and (.data | has("raw_tx_hex") | not)' \
  "coordinator exposed raw transaction material after expiry"

if JUNO_COORDINATOR_URL="$coordinator_url" \
  JUNO_COORDINATOR_TOKEN="$coordinator_token" \
  JUNO_NETWORK=regtest \
  JUNO_WALLET_ID="$wallet_id" \
  JUNO_IDEMPOTENCY_KEY="$coordinator_expiry_creation_key" \
    node "$workspace_root/juno-exchange-sdk/examples/create-raw-transaction.mjs" \
      withdrawal:e2e-expiry \
      "$expiry_destination_address" \
      500000 \
      >"$run_dir/coordinator-expiry-sdk-rejected.stdout" \
      2>"$run_dir/coordinator-expiry-sdk-rejected.json"; then
  fail "Node SDK returned expired raw transaction material as broadcastable"
fi
assert_jq "$run_dir/coordinator-expiry-sdk-rejected.json" \
  '.code == "transaction_attempt_expired_pending_reconciliation" and .retryable == false' \
  "Node SDK did not reject expired raw transaction material with the expected error"

tip_height="$(node_cli getblockcount | jq -er '.')"
release_guard_height=$((coordinator_expiry_height + 99))
if (( tip_height < release_guard_height )); then
  node_cli generate "$((release_guard_height - tip_height))" \
    >"$run_dir/coordinator-expiry-release-guard-blocks.json"
fi
wait_ready "$run_dir/ready-before-coordinator-release.json"
code="$(coordinator_api_status GET "/v1/transaction-attempts/$coordinator_expiry_attempt_id" "$run_dir/coordinator-expiry-before-release.json")"
[[ "$code" == "200" ]] || fail "pre-release coordinator lookup returned HTTP $code"
assert_jq "$run_dir/coordinator-expiry-before-release.json" \
  '.data.state == "expired_pending_reconciliation"' \
  "coordinator released notes before expiry plus 100 confirmations"

node_cli generate 1 >"$run_dir/coordinator-expiry-release-block.json"
wait_ready "$run_dir/ready-at-coordinator-release.json"
wait_coordinator_state "$coordinator_expiry_attempt_id" released \
  "$run_dir/coordinator-expiry-state-released.json" \
  || fail "coordinator did not release the proven-unspent notes at the strict boundary"
wait_note_status "$run_dir/coordinator-expiry-note-status-request.json" \
  "$run_dir/coordinator-expiry-notes-released.json" \
  '.data.statuses | all(.state == "unspent")' \
  "coordinator released its reservation without all selected notes being unspent"

log "Integration: exclude a real deposit sent to an unallocated UFVK address"
"$workspace_root/juno-addrgen/bin/juno-addrgen" derive \
  --ufvk "$ufvk" \
  --index 100 \
  --json >"$run_dir/unallocated-address.json"
unallocated_address="$(jq -er '.address' "$run_dir/unallocated-address.json")"
unallocated_txid="$(send_mature_coinbase_deposit "$unallocated_address" deposit-unallocated)"
node_cli generate 1 >"$run_dir/unallocated-deposit-block.json"
wait_ready "$run_dir/ready-unallocated-detected.json"
assert_no_deposit "$unallocated_txid" "$run_dir/unallocated-deposit-detected.json"
code="$(api_status GET "/v1/wallets/$wallet_id/addresses/$unallocated_address/balance" "$run_dir/unallocated-balance.json")"
[[ "$code" == "404" ]] || fail "real unallocated UFVK address balance must return 404"
node_cli generate 99 >"$run_dir/unallocated-confirmation-blocks.json"
wait_ready "$run_dir/ready-unallocated-confirmed.json"
assert_no_deposit "$unallocated_txid" "$run_dir/unallocated-deposit-confirmed.json"

log "Recovery: wipe scanner only, require epoch reset, replay, then detect a new deposit"
code="$(api_status GET "/v1/wallets/$wallet_id/deposits?limit=1000" "$run_dir/deposits-before-recovery.json")"
[[ "$code" == "200" ]] || fail "pre-recovery deposits returned HTTP $code"
old_cursor="$(jq -er '.data.next_cursor' "$run_dir/deposits-before-recovery.json")"
code="$(api_status GET "/v1/wallets/$wallet_id/addresses/$deposit_address/balance" "$run_dir/balance-before-recovery.json")"
[[ "$code" == "200" ]] || fail "pre-recovery balance returned HTTP $code"

scanner_id="$("${compose[@]}" ps -q juno-scan)"
scanner_volume="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/var/lib/juno-scan"}}{{.Name}}{{end}}{{end}}' "$scanner_id")"
[[ -n "$scanner_volume" ]] || fail "could not identify scanner data volume"
"${compose[@]}" stop gateway juno-scan >/dev/null
"${compose[@]}" rm -f juno-scan >/dev/null
docker volume rm "$scanner_volume" >/dev/null
"${compose[@]}" up -d juno-scan gateway

wait_live
code="$(api_status GET /v1/health/ready "$run_dir/ready-during-scanner-recovery.json")"
[[ "$code" == "503" ]] || fail "financial readiness did not close during scanner rebuild (HTTP $code)"
wait_ready "$run_dir/ready-after-scanner-recovery.json"

code="$(api_status GET "/v1/wallets/$wallet_id/deposits?limit=1000&cursor=$old_cursor" "$run_dir/deposits-old-cursor.json")"
[[ "$code" == "409" ]] || fail "pre-recovery cursor must require explicit reset, got HTTP $code"
assert_jq "$run_dir/deposits-old-cursor.json" \
  '.error.code == "cursor_reset_required" and .error.details.action == "restart_without_cursor"' \
  "cursor epoch mismatch did not return reset instructions"

code="$(api_status GET "/v1/wallets/$wallet_id/deposits?limit=1000" "$run_dir/deposits-after-recovery.json")"
[[ "$code" == "200" ]] || fail "post-recovery replay returned HTTP $code"
reset_cursor="$(jq -er '.data.next_cursor' "$run_dir/deposits-after-recovery.json")"
reset_epoch="$(jq -er '.data.event_epoch' "$run_dir/deposits-after-recovery.json")"
assert_jq "$run_dir/deposits-after-recovery.json" --arg txid "$deposit_txid" \
  '.data.deposits | any(.txid == $txid and .status == "confirmed")' \
  "confirmed external deposit was not replayed after scanner rebuild"
assert_jq "$run_dir/deposits-after-recovery.json" --arg txid "$withdrawal_txid" \
  '.data.deposits | all(.txid != $txid)' \
  "withdrawal change appeared after scanner rebuild"

code="$(api_status GET "/v1/wallets/$wallet_id/addresses/$deposit_address/balance" "$run_dir/balance-after-recovery.json")"
[[ "$code" == "200" ]] || fail "post-recovery balance returned HTTP $code"
jq -S '.data.balance' "$run_dir/balance-before-recovery.json" >"$run_dir/balance-before.normalized.json"
jq -S '.data.balance' "$run_dir/balance-after-recovery.json" >"$run_dir/balance-after.normalized.json"
cmp -s "$run_dir/balance-before.normalized.json" "$run_dir/balance-after.normalized.json" || \
  fail "scanner rebuild changed the recovered address balance"

post_recovery_txid="$(send_mature_coinbase_deposit "$deposit_address" deposit-after-recovery)"
code="$(api_status GET "/v1/wallets/$wallet_id/deposits?limit=1000&cursor=$reset_cursor" "$run_dir/deposits-after-post-recovery-node-sync.json")"
case "$code" in
  200)
    assert_jq "$run_dir/deposits-after-post-recovery-node-sync.json" --arg epoch "$reset_epoch" \
      '.data.event_epoch == $epoch' \
      "node wallet synchronization retained the cursor under a different scanner epoch"
    ;;
  409)
    assert_jq "$run_dir/deposits-after-post-recovery-node-sync.json" --arg epoch "$reset_epoch" \
      '.error.code == "cursor_reset_required"
        and .error.details.action == "restart_without_cursor"
        and .error.details.event_epoch != $epoch' \
      "node wallet synchronization returned invalid cursor-reset instructions"
    ;;
  *)
    fail "deposit cursor continuity after node wallet synchronization returned HTTP $code"
    ;;
esac

code="$(api_status GET "/v1/wallets/$wallet_id/deposits?limit=1000" "$run_dir/deposits-before-post-recovery-block.json")"
[[ "$code" == "200" ]] || fail "cursorless replay after node wallet synchronization returned HTTP $code"
post_recovery_cursor="$(jq -er '.data.next_cursor' "$run_dir/deposits-before-post-recovery-block.json")"
post_recovery_epoch="$(jq -er '.data.event_epoch' "$run_dir/deposits-before-post-recovery-block.json")"
assert_jq "$run_dir/deposits-before-post-recovery-block.json" \
  --arg prior_txid "$deposit_txid" \
  --arg new_txid "$post_recovery_txid" \
  '.data.deposits | any(.txid == $prior_txid and .status == "confirmed")
    and all(.txid != $new_txid)' \
  "cursorless replay after node wallet synchronization lost history or exposed an unmined deposit"
assert_jq "$run_dir/deposit-after-recovery-ready-after-node-sync.json" --arg epoch "$post_recovery_epoch" \
  '.data.scanner.event_epoch == $epoch' \
  "deposit cursor epoch differed from the synchronized scanner readiness epoch"

node_cli generate 1 >"$run_dir/post-recovery-deposit-block.json"
post_recovery_block_hash="$(jq -er '.[0]' "$run_dir/post-recovery-deposit-block.json")"
wait_ready "$run_dir/ready-post-recovery-deposit.json"
code="$(api_status GET "/v1/wallets/$wallet_id/deposits?limit=100&cursor=$post_recovery_cursor" "$run_dir/post-recovery-new-deposit.json")"
[[ "$code" == "200" ]] || fail "new post-recovery deposit poll returned HTTP $code"
assert_jq "$run_dir/post-recovery-new-deposit.json" --arg txid "$post_recovery_txid" \
  '.data.deposits | any(.txid == $txid and .status == "detected")' \
  "new deposit was skipped after controlled cursor reset"

log "Manual reorg: confirmed to unconfirmed to orphaned"
node_cli generate 99 >"$run_dir/post-recovery-confirmation-blocks.json"
wait_ready "$run_dir/ready-before-reorg.json"
wait_deposit_status "$post_recovery_txid" confirmed "$run_dir/post-recovery-deposit-confirmed.json"
confirmation_tip_hash="$(jq -er '.[-1]' "$run_dir/post-recovery-confirmation-blocks.json")"
node_cli invalidateblock "$confirmation_tip_hash" >"$run_dir/reorg-confirmation-tip-invalidate.json"
wait_ready "$run_dir/ready-after-confirmation-rollback.json"
wait_deposit_status "$post_recovery_txid" unconfirmed "$run_dir/post-recovery-deposit-unconfirmed.json"
node_cli invalidateblock "$post_recovery_block_hash" >"$run_dir/reorg-deposit-invalidate.json"
wait_ready "$run_dir/ready-after-deposit-orphan.json"
wait_deposit_status "$post_recovery_txid" orphaned "$run_dir/post-recovery-deposit-orphaned.json"
node_cli getrawmempool >"$run_dir/mempool-after-reorg.json"
if jq -e --arg txid "$post_recovery_txid" 'index($txid) != null' "$run_dir/mempool-after-reorg.json" >/dev/null; then
  printf 'returned_to_mempool\n' >"$run_dir/reorg-transaction-disposition.txt"
else
  printf 'not_in_mempool\n' >"$run_dir/reorg-transaction-disposition.txt"
fi
node_cli generate 1 >"$run_dir/reorg-replacement-block.json"
wait_ready "$run_dir/ready-after-reorg-replacement.json"

gateway_loss_checks='[]'
if [[ "${SKIP_GATEWAY_LOSS_TEST:-0}" != "1" ]]; then
  log "Audited recovery: wipe gateway and scanner databases while retaining installation state"
  gateway_id="$("${compose[@]}" ps -q gateway)"
  gateway_volume="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/var/lib/juno-gateway"}}{{.Name}}{{end}}{{end}}' "$gateway_id")"
  [[ -n "$gateway_volume" ]] || fail "could not identify gateway data volume"
  scanner_id="$("${compose[@]}" ps -q juno-scan)"
  scanner_volume="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/var/lib/juno-scan"}}{{.Name}}{{end}}{{end}}' "$scanner_id")"
  [[ -n "$scanner_volume" ]] || fail "could not identify scanner data volume for joint recovery"
  "${compose[@]}" stop gateway juno-scan >/dev/null
  "${compose[@]}" rm -f gateway juno-scan >/dev/null
  docker volume rm "$gateway_volume" >/dev/null
  docker volume rm "$scanner_volume" >/dev/null
  if "${compose[@]}" run --no-deps --rm -T gateway >"$run_dir/joint-loss-guard.log" 2>&1; then
    fail "fresh gateway and scanner databases served against a retained manifest"
  fi
  grep -F 'gateway database is not bound to this installation' "$run_dir/joint-loss-guard.log" >/dev/null || \
    fail "joint database loss did not require explicit audited recovery"
  if curl -fsS --max-time 2 "$base_url/v1/health/live" >"$run_dir/gateway-loss-live.txt" 2>&1; then
    fail "fresh gateway DB exposed a live endpoint before audited recovery"
  fi

  "${compose[@]}" run --no-deps --rm -T gateway recovery-checksum \
    --next-index "$cold_wallet_id=7" >"$run_dir/recovery-checksum.json"
  recovery_checksum="$(jq -er '.mapping_sha256' "$run_dir/recovery-checksum.json")"
  "${compose[@]}" run --no-deps --rm -T gateway recover \
    --acknowledge "$recover_ack" \
    --mapping-sha256 "$recovery_checksum" \
    --next-index "$cold_wallet_id=7" >"$run_dir/recovery.json"
  assert_jq "$run_dir/recovery.json" --arg checksum "$recovery_checksum" \
    '.status == "recovered" and .mapping_sha256 == $checksum and .coordinator_automation == "sealed"' \
    "audited gateway recovery returned invalid output"
  recovery_installation_id="$(jq -er '.installation_id' "$run_dir/recovery.json")"

  "${compose[@]}" up -d juno-scan gateway
  wait_live
  wait_ready "$run_dir/ready-after-joint-recovery.json"
  code="$(coordinator_api_status GET /v1/health/ready "$run_dir/coordinator-ready-sealed-after-recovery.json")"
  [[ "$code" == "503" ]] || fail "recovered coordinator readiness returned HTTP $code instead of remaining sealed"
  assert_jq "$run_dir/coordinator-ready-sealed-after-recovery.json" \
    '.error.code == "coordinator_not_ready" and (.error.message | contains("sealed after gateway database recovery"))' \
    "recovered coordinator readiness did not report its automation seal"

  jq -n --arg wallet "$wallet_id" --arg destination "$expiry_destination_address" \
    '{wallet_id:$wallet,approval_reference:"recovery-seal:e2e",outputs:[{to_address:$destination,amount_zat:"1000000000000000"}]}' \
    >"$run_dir/recovery-sealed-create-request.json"
  recovery_sealed_create_key="recovery-sealed-create-$(openssl rand -hex 8)"
  code="$(coordinator_api_status POST /v1/transaction-attempts "$run_dir/recovery-sealed-create-response.json" "$run_dir/recovery-sealed-create-request.json" "$recovery_sealed_create_key")"
  [[ "$code" == "503" ]] || fail "recovered coordinator accepted creation while sealed, HTTP $code"
  assert_jq "$run_dir/recovery-sealed-create-response.json" \
    '.error.code == "coordinator_recovery_sealed" and .error.retryable == false' \
    "recovered coordinator creation did not fail with the recovery seal error"

  jq -n '{label:"customer-1004"}' >"$run_dir/allocate-4-request.json"
  code="$(api_status POST "/v1/wallets/$wallet_id/addresses" "$run_dir/address-4.json" "$run_dir/allocate-4-request.json" "" "$address_token")"
  [[ "$code" == "201" ]] || fail "allocation after audited recovery returned HTTP $code"
  assert_jq "$run_dir/address-4.json" '.data.diversifier_index == 4' \
    "recovered gateway reused or skipped the expected next hot-wallet index"

  jq -n '{label:"cold-explicit-high-water"}' >"$run_dir/cold-allocate-7-request.json"
  code="$(api_status POST "/v1/wallets/$cold_wallet_id/addresses" "$run_dir/cold-address-7.json" "$run_dir/cold-allocate-7-request.json" "" "$cold_wallet_token")"
  [[ "$code" == "201" ]] || fail "allocation after explicit high-water recovery returned HTTP $code"
  assert_jq "$run_dir/cold-address-7.json" '.data.diversifier_index == 7' \
    "explicit high-water recovery did not start at index 7"

  code="$(api_status GET "/v1/wallets/$wallet_id/deposits?txid=$deposit_txid&status=confirmed&limit=100" "$run_dir/deposit-after-joint-recovery.json")"
  [[ "$code" == "200" ]] || fail "deposit query after joint recovery returned HTTP $code"
  assert_jq "$run_dir/deposit-after-joint-recovery.json" --arg txid "$deposit_txid" \
    '.data.deposits | any(.txid == $txid and .status == "confirmed")' \
    "scanner did not rescan the confirmed deposit after joint recovery"

  if "${compose[@]}" run --no-deps --rm -T gateway recovery-unseal-coordinator \
    --acknowledge WRONG_ACKNOWLEDGEMENT \
    --installation-id "$recovery_installation_id" \
    --reconciliation-reference "regtest-e2e:$run_id" \
    >"$run_dir/recovery-unseal-wrong-ack.log" 2>&1; then
    fail "coordinator recovery unseal accepted the wrong acknowledgement"
  fi
  grep -F 'requires exact acknowledgement' "$run_dir/recovery-unseal-wrong-ack.log" >/dev/null || \
    fail "wrong coordinator recovery unseal acknowledgement returned the wrong error"

  "${compose[@]}" run --no-deps --rm -T gateway recovery-unseal-coordinator \
    --acknowledge "$recovery_unseal_ack" \
    --installation-id "$recovery_installation_id" \
    --reconciliation-reference "regtest-e2e:$run_id" \
    >"$run_dir/recovery-unseal.json"
  assert_jq "$run_dir/recovery-unseal.json" --arg installation "$recovery_installation_id" \
    '.status == "coordinator_automation_unsealed" and .installation_id == $installation' \
    "audited coordinator recovery unseal returned invalid output"
  "${compose[@]}" run --no-deps --rm -T gateway recovery-unseal-coordinator \
    --acknowledge "$recovery_unseal_ack" \
    --installation-id "$recovery_installation_id" \
    --reconciliation-reference "regtest-e2e:$run_id" \
    >"$run_dir/recovery-unseal-replay.json"
  assert_jq "$run_dir/recovery-unseal-replay.json" \
    '.status == "coordinator_automation_already_unsealed"' \
    "coordinator recovery unseal did not replay its durable audit result"
  wait_coordinator_ready "$run_dir/coordinator-ready-after-recovery-unseal.json" \
    || fail "transaction coordinator did not become ready after audited recovery unseal"

  code="$(coordinator_api_status POST /v1/transaction-attempts "$run_dir/recovery-unsealed-create-response.json" "$run_dir/recovery-sealed-create-request.json" "$recovery_sealed_create_key")"
  [[ "$code" == "202" ]] || fail "reconciled coordinator did not accept creation after unseal, HTTP $code"
  recovery_unsealed_attempt_id="$(jq -er '.data.attempt_id' "$run_dir/recovery-unsealed-create-response.json")"
  wait_coordinator_state "$recovery_unsealed_attempt_id" failed_unsigned \
    "$run_dir/recovery-unsealed-create-failed-unsigned.json" \
    || fail "post-unseal insufficient-balance attempt did not terminate unsigned"
  gateway_loss_checks='["joint database-loss guard","audited registry recovery","explicit high-water recovery","recovered-database coordinator seal","audited coordinator recovery unseal"]'
fi

jq -n \
  --arg project "$project" \
  --arg deposit_txid "$deposit_txid" \
  --arg cold_deposit_txid "$cold_deposit_txid" \
  --arg withdrawal_txid "$withdrawal_txid" \
  --arg expiry_txid "$expiry_txid" \
  --arg coordinator_expiry_txid "$coordinator_expiry_txid" \
  --arg post_recovery_txid "$post_recovery_txid" \
  --arg addrgen_ref "$JUNO_ADDRGEN_REF" \
  --arg gateway_ref "$JUNO_GATEWAY_REVISION" \
  --arg keys_ref "$JUNO_KEYS_REF" \
  --arg scanner_ref "$JUNO_SCAN_REF" \
  --arg txbuild_ref "$JUNO_TXBUILD_REF" \
  --arg txsign_ref "$JUNO_TXSIGN_REF" \
  --arg sdk_ref "$JUNO_SDK_REF" \
  --argjson gateway_loss_checks "$gateway_loss_checks" \
  '{status:"passed",network:"regtest",default_confirmations:100,project:$project,deposit_source:"mature_coinbase_shield",deposit_txid:$deposit_txid,cold_deposit_txid:$cold_deposit_txid,withdrawal_txid:$withdrawal_txid,expiry_txid:$expiry_txid,coordinator_expiry_txid:$coordinator_expiry_txid,post_recovery_deposit_txid:$post_recovery_txid,component_refs:{gateway:$gateway_ref,"juno-addrgen":$addrgen_ref,"juno-keys":$keys_ref,"juno-scan":$scanner_ref,"juno-txbuild":$txbuild_ref,"juno-txsign":$txsign_ref,"juno-exchange-sdk":$sdk_ref},checks:(["clean source provenance","one-time installation init","separate loopback public and private ports","Docker outbound masquerading disabled","chain tip","NU6.2 regtest signing branch","least-privilege public and coordinator authentication","wallet isolation","network-disabled UDS signer","mandatory seed-to-UFVK binding","mature owned coinbase deposit source","second-wallet deposit and effects","watch-only allocation","restart-safe address ledger","owned-address balances","wallet-wide SDK balance","100-confirmation deposit lifecycle","scanner restart cursor reset and replay","unallocated deposit exclusion","Node SDK programmatic create","coordinator durable attempt","selected-note reservation","selected-note unspent reconciliation","selected-note unknown and wallet isolation","signed raw hex return","SDK programmatic broadcast","prevalidated raw broadcast","idempotent create and broadcast replay","same-key payload conflict","outgoing wallet effects","registered coordinator change scope","coordinator broadcast, mined, and final lifecycle","selected-note pending and spent lifecycle","mined pending-spend release","withdrawal expiry and drop","selected-note strict expiry boundary","coordinator expired-material rejection","coordinator post-expiry finality hold","coordinator proven-unspent release","strict post-expiry pending-spend release","transaction lookup","change exclusion","scanner rebuild","cursor epoch reset","post-recovery delivery","confirmed-unconfirmed-orphaned reorg"] + $gateway_loss_checks)}' \
  >"$run_dir/summary.json"

log "PASS"
jq . "$run_dir/summary.json"
