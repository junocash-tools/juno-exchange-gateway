  '.data.as_of_scanner_height >= $expiry
    and .data.pending_spend.note_count == $count
    and .data.pending_spend.value_zat == $value
    and .data.pending_spend.known_expiry_count == $count
    and .data.pending_spend.next_expiry_height == $expiry
    and .data.pending_spend.last_expiry_height == $expiry' \
  "pending inputs cleared at, rather than after, the transaction expiry height" \
  --argjson expiry "$expiry_height" \
  --argjson count "$expiry_pending_count" \
  --argjson value "$expiry_pending_value"
wait_note_status "$run_dir/expiry-note-status-request.json" "$run_dir/expiry-notes-at-boundary.json" \
  '.data.statuses | all(.state == "pending" and .pending_spent_txid == $txid and .pending_spent_expiry_height == $expiry)' \
  "selected notes cleared at, rather than after, the expiry height" \
  --arg txid "$expiry_txid" --argjson expiry "$expiry_height"

