#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workspace_root="$(cd "$repo_root/.." && pwd)"
run_id="$(date -u +%Y%m%dt%H%M%Sz)-$$"
run_dir="$repo_root/tmp/regtest-e2e/$run_id"
project="juno-gateway-e2e-${run_id//[^A-Za-z0-9]/}"

mkdir -p "$run_dir/config"
chmod 0700 "$run_dir"
umask 077

for command in cargo curl docker go jq make node npm openssl python3; do
  command -v "$command" >/dev/null || {
    echo "missing required command: $command" >&2
    exit 1
  }
done

"$repo_root/scripts/check-clean-sources"

export JUNO_NETWORK=regtest
export JUNO_GATEWAY_BIND=127.0.0.1
export JUNO_GATEWAY_WALLETS_FILE="$run_dir/config/wallets.json"
export JUNO_GATEWAY_AUTH_FILE="$run_dir/config/auth.json"
export JUNO_INSTALLATION_STATE_DIR="$run_dir/installation-state"
export JUNO_RPC_USER="e2e-rpc-$(openssl rand -hex 8)"
export JUNO_RPC_PASSWORD="$(openssl rand -hex 32)"
export JUNO_SCAN_API_BEARER_TOKEN="$(openssl rand -hex 32)"
export JUNO_NODE_PERSIST_MEMPOOL=0
export JUNO_GATEWAY_DEFAULT_CONFIRMATIONS=100
export JUNO_SCAN_CONFIRMATIONS=100
export JUNO_GATEWAY_BACKFILL_BATCH_SIZE=10
export JUNO_GATEWAY_BACKFILL_YIELD=250ms
export JUNO_COORDINATOR_ENABLED=true
export JUNO_GATEWAY_REVISION="$(git -C "$repo_root" rev-parse HEAD)"
export JUNO_GATEWAY_BUILD_TIME="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
export JUNO_SCAN_REF="$(git -C "$workspace_root/juno-scan" rev-parse HEAD)"
export JUNO_ADDRGEN_REF="$(git -C "$workspace_root/juno-addrgen" rev-parse HEAD)"
export JUNO_TXBUILD_REF="$(git -C "$workspace_root/juno-txbuild" rev-parse HEAD)"
export JUNO_TXSIGN_REF="$(git -C "$workspace_root/juno-txsign" rev-parse HEAD)"
export JUNO_KEYS_REF="$(git -C "$workspace_root/juno-keys" rev-parse HEAD)"
export JUNO_SDK_REF="$(git -C "$workspace_root/juno-exchange-sdk" rev-parse HEAD)"

read_token="$(openssl rand -hex 32)"
address_token="$(openssl rand -hex 32)"
broadcast_token="$(openssl rand -hex 32)"
treasury_token="$(openssl rand -hex 32)"
coordinator_token="$(openssl rand -hex 32)"
cold_wallet_token="$(openssl rand -hex 32)"
wallet_id="exchange-hot"
cold_wallet_id="exchange-cold"
signer_image=""
signer_container="${project}-offline-signer"
init_ack="I_UNDERSTAND_THIS_CREATES_A_NEW_JUNO_INSTALLATION"
recover_ack="I_UNDERSTAND_RECOVERY_REBUILDS_JUNO_ADDRESS_STATE"
recovery_unseal_ack="I_HAVE_RECONCILED_ALL_PRIOR_JUNO_TRANSACTION_ATTEMPTS"
nu62_branch_hex="5437f330"
nu62_branch_id=1412952880

mkdir -p "$JUNO_INSTALLATION_STATE_DIR"
chmod 0700 "$JUNO_INSTALLATION_STATE_DIR"

compose=(
  docker compose
  --project-name "$project"
  --profile operator
  --profile automation
  -f "$repo_root/compose.yaml"
  -f "$repo_root/compose.automation.yaml"
  -f "$repo_root/compose.dev.yaml"
)

base_url=""
coordinator_url=""

cleanup() {
  status=$?
  trap - EXIT
  docker rm -f "$signer_container" >/dev/null 2>&1 || true
  "${compose[@]}" ps -a >"$run_dir/compose-ps.txt" 2>&1 || true
  if (( status != 0 )); then
    "${compose[@]}" logs --no-color >"$run_dir/compose.log" 2>&1 || true
    echo "regtest E2E failed; private evidence is in $run_dir" >&2
  fi
  if [[ "${KEEP_STACK:-0}" != "1" ]]; then
    "${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
  else
    echo "stack retained: project=$project evidence=$run_dir"
  fi
  exit "$status"
}
trap cleanup EXIT

log() {
  printf '\n== %s ==\n' "$1"
}

fail() {
  echo "$1" >&2
  exit 1
}

assert_source_ref() {
  local label=$1
  local path=$2
  local expected=$3
  local actual
  actual="$(git -C "$path" rev-parse HEAD)"
  [[ "$actual" == "$expected" ]] || fail "$label HEAD moved during release E2E setup"
}

assert_source_refs() {
  assert_source_ref gateway "$repo_root" "$JUNO_GATEWAY_REVISION"
  assert_source_ref scanner "$workspace_root/juno-scan" "$JUNO_SCAN_REF"
  assert_source_ref addrgen "$workspace_root/juno-addrgen" "$JUNO_ADDRGEN_REF"
  assert_source_ref txbuild "$workspace_root/juno-txbuild" "$JUNO_TXBUILD_REF"
  assert_source_ref txsign "$workspace_root/juno-txsign" "$JUNO_TXSIGN_REF"
  assert_source_ref keys "$workspace_root/juno-keys" "$JUNO_KEYS_REF"
  assert_source_ref sdk "$workspace_root/juno-exchange-sdk" "$JUNO_SDK_REF"
}

assert_jq() {
  local file=$1
  shift
  local count=$#
  local message="${!count}"
  set -- "${@:1:$((count - 1))}"
  jq -e "$@" "$file" >/dev/null || fail "$message"
}

api_status() {
  local method=$1
  local path=$2
  local output=$3
  local body_file=${4:-}
  local idempotency_key=${5:-}
  local token="${6-$read_token}"
  local args=(
    -sS
    -o "$output"
    -w '%{http_code}'
    -X "$method"
    -H 'Accept: application/json'
  )
  if [[ -n "$token" ]]; then
    args+=( -H "Authorization: Bearer $token" )
  fi
  if [[ -n "$body_file" ]]; then
    args+=( -H 'Content-Type: application/json' --data-binary "@$body_file" )
  fi
  if [[ -n "$idempotency_key" ]]; then
    args+=( -H "Idempotency-Key: $idempotency_key" )
  fi
  curl "${args[@]}" "$base_url$path" || true
}

coordinator_api_status() {
  local method=$1
  local path=$2
  local output=$3
  local body_file=${4:-}
  local idempotency_key=${5:-}
  local token="${6-$coordinator_token}"
  local args=(
    -sS
    -o "$output"
    -w '%{http_code}'
    -X "$method"
    -H 'Accept: application/json'
  )
  if [[ -n "$token" ]]; then
    args+=( -H "Authorization: Bearer $token" )
  fi
  if [[ -n "$body_file" ]]; then
    args+=( -H 'Content-Type: application/json' --data-binary "@$body_file" )
  fi
  if [[ -n "$idempotency_key" ]]; then
    args+=( -H "Idempotency-Key: $idempotency_key" )
  fi
  curl "${args[@]}" "$coordinator_url$path" || true
}

wait_coordinator_ready() {
  local output=$1
  local deadline=$((SECONDS + 180))
  while (( SECONDS < deadline )); do
    if [[ "$(coordinator_api_status GET /v1/health/ready "$output")" == "200" ]] &&
      jq -e '.status == "ok" and .data.status == "ready"' "$output" >/dev/null; then
      return 0
    fi
    sleep 0.25
  done
  return 1
}

wait_coordinator_state() {
  local attempt_id=$1
  local expected_state=$2
  local output=$3
  local deadline=$((SECONDS + 180))
  while (( SECONDS < deadline )); do
    if [[ "$(coordinator_api_status GET "/v1/transaction-attempts/$attempt_id" "$output")" == "200" ]] &&
      jq -e --arg state "$expected_state" '.status == "ok" and .data.state == $state' "$output" >/dev/null; then
      return 0
    fi
    sleep 0.25
  done
  return 1
}

wait_live() {
  local deadline=$((SECONDS + 180))
  while (( SECONDS < deadline )); do
    if curl -fsS "$base_url/v1/health/live" >"$run_dir/live.json" 2>/dev/null; then
      return 0
    fi
    sleep 0.25
  done
  fail "gateway liveness timeout"
}

wait_ready() {
  local output=$1
  local deadline=$((SECONDS + 600))
  local scratch="$run_dir/.ready.json"
  while (( SECONDS < deadline )); do
    local code
    code="$(api_status GET /v1/health/ready "$scratch")"
    if [[ "$code" == "200" ]] && jq -e '.status == "ok"' "$scratch" >/dev/null 2>&1; then
      cp "$scratch" "$output"
      return 0
    fi
    sleep 0.25
  done
  cp "$scratch" "$output" 2>/dev/null || true
  fail "gateway readiness timeout"
}

wait_deposit_status() {
  local txid=$1
  local status=$2
  local output=$3
  local deadline=$((SECONDS + 300))
  while (( SECONDS < deadline )); do
    local code
    code="$(api_status GET "/v1/wallets/$wallet_id/deposits?txid=$txid&status=$status&limit=100" "$output")"
    if [[ "$code" == "200" ]] && jq -e --arg txid "$txid" --arg status "$status" \
      '.data.deposits | any(.txid == $txid and .status == $status)' "$output" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  fail "deposit $txid did not reach status $status"
}

wait_wallet_deposit_status() {
  local target_wallet=$1
  local token=$2
  local txid=$3
  local status=$4
  local output=$5
  local deadline=$((SECONDS + 300))
  while (( SECONDS < deadline )); do
    local code
    code="$(api_status GET "/v1/wallets/$target_wallet/deposits?txid=$txid&status=$status&limit=100" "$output" "" "" "$token")"
    if [[ "$code" == "200" ]] && jq -e --arg txid "$txid" --arg status "$status" \
      '.data.deposits | any(.txid == $txid and .status == $status)' "$output" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  fail "wallet $target_wallet deposit $txid did not reach status $status"
}

wait_wallet_effect_kind() {
  local target_wallet=$1
  local token=$2
  local txid=$3
  local kind=$4
  local output=$5
  local deadline=$((SECONDS + 300))
  while (( SECONDS < deadline )); do
    local code
    code="$(api_status GET "/v1/transactions/$txid?wallet_id=$target_wallet" "$output" "" "" "$token")"
    if [[ "$code" == "200" ]] && jq -e --arg kind "$kind" \
      '.data.wallet_effects | any(.kind == $kind)' "$output" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  fail "wallet $target_wallet transaction $txid did not expose effect $kind"
}

wait_wallet_registered_change_output() {
  local target_wallet=$1
  local token=$2
  local txid=$3
  local address=$4
  local output=$5
  local deadline=$((SECONDS + 300))
  while (( SECONDS < deadline )); do
    local code
    code="$(api_status GET "/v1/transactions/$txid?wallet_id=$target_wallet" "$output" "" "" "$token")"
    if [[ "$code" == "200" ]] && jq -e --arg txid "$txid" --arg address "$address" \
      '.data.wallet_effects | any(.kind == "OutgoingOutputEvent"
        and .txid == $txid
        and .address == $address
        and .recipient_scope == "external"
        and .ovk_scope == "external")' "$output" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  fail "wallet $target_wallet transaction $txid did not expose its registered change output with the expected scopes"
}

wait_note_summary() {
  local output=$1
  local filter=$2
  local message=$3
  shift 3
  local deadline=$((SECONDS + 300))
  while (( SECONDS < deadline )); do
    local code
    code="$(api_status GET "/v1/wallets/$wallet_id/notes/summary?min_confirmations=100" "$output" "" "" "$treasury_token")"
    if [[ "$code" == "200" ]] && jq -e "$@" "$filter" "$output" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  fail "$message"
}

wait_note_status() {
  local request=$1
  local output=$2
  local filter=$3
  local message=$4
  shift 4
  local deadline=$((SECONDS + 300))
  while (( SECONDS < deadline )); do
    local code
    code="$(api_status POST "/v1/wallets/$wallet_id/notes/status" "$output" "$request" "" "$treasury_token")"
    if [[ "$code" == "200" ]] && jq -e "$@" "$filter" "$output" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  fail "$message"
}

wait_node() {
  local deadline=$((SECONDS + 180))
  while (( SECONDS < deadline )); do
    if node_cli getblockcount >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  fail "junocashd readiness timeout"
}

wait_node_wallet_notified() {
  local expected_height=$1
  local expected_hash=$2
  local output=$3
  local deadline=$((SECONDS + 180))
  while (( SECONDS < deadline )); do
    if node_cli getblockchaininfo >"$output" 2>/dev/null && jq -e \
      --arg hash "$expected_hash" \
      --argjson height "$expected_height" \
      '.blocks == $height and .bestblockhash == $hash and .fullyNotified == true' \
      "$output" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.2
  done
  fail "junocashd wallet was not fully notified at height $expected_height"
}

wait_scanner_event_kind() {
  local target_wallet=$1
  local txid=$2
  local kind=$3
  local output=$4
  local deadline=$((SECONDS + 300))
  while (( SECONDS < deadline )); do
    if "${compose[@]}" exec -T juno-scan curl -fsS \
      -H "Authorization: Bearer $JUNO_SCAN_API_BEARER_TOKEN" \
      "http://127.0.0.1:8080/v1/wallets/$target_wallet/events?cursor=0&limit=1000&kind=$kind&txid=$txid" \
      >"$output" 2>/dev/null && jq -e --arg kind "$kind" --arg txid "$txid" \
      '.events | any(.kind == $kind and .payload.txid == $txid)' "$output" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  fail "scanner event $kind for $txid did not appear"
}

assert_no_deposit() {
  local txid=$1
  local output=$2
  local code
  code="$(api_status GET "/v1/wallets/$wallet_id/deposits?txid=$txid&limit=100" "$output")"
  [[ "$code" == "200" ]] || fail "deposit exclusion request returned HTTP $code"
  assert_jq "$output" '.data.deposits | length == 0' "excluded transaction appeared in public deposits"
}

node_cli() {
  "${compose[@]}" exec -T junocashd juno-cli "$@"
}

assert_regtest_nu62() {
  local output=$1
  node_cli getblockchaininfo >"$output"
  assert_jq "$output" \
    --arg branch "$nu62_branch_hex" \
    '.chain == "regtest"
      and ((.consensus.chaintip | ascii_downcase) == $branch)
      and ((.consensus.nextblock | ascii_downcase) == $branch)' \
    "regtest must be on NU6.2 branch 5437f330 before Orchard signing"
}

wait_operation() {
  local opid=$1
  local output=$2
  local deadline=$((SECONDS + 600))
  while (( SECONDS < deadline )); do
    node_cli z_getoperationstatus "[\"$opid\"]" >"$output"
    local state
    state="$(jq -r '.[0].status // ""' "$output")"
    case "$state" in
      success)
        jq -er '.[0].result.txid' "$output"
        return 0
        ;;
      failed)
        jq -r '.[0].error.message // "operation failed"' "$output" >&2
        return 1
        ;;
    esac
    sleep 0.25
  done
  fail "asynchronous node operation timed out"
}

operation_id_from_file() {
  local file=$1
  local opid
  local pattern='^opid-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
  if opid="$(jq -er \
    'if type == "object" then .opid else . end | select(type == "string")' \
    "$file" 2>/dev/null)" && [[ "$opid" =~ $pattern ]]; then
    printf '%s\n' "$opid"
    return 0
  fi
  opid="$(tr -d '\r\n' <"$file")"
  if [[ "$opid" =~ $pattern ]]; then
    printf '%s\n' "$opid"
    return 0
  fi
  return 1
}

send_mature_coinbase_deposit() {
  local destination_address=$1
  local prefix=$2

  # The pinned node's wallet processes chain-tip notifications asynchronously,
  # while Orchard transaction construction requires an exact wallet/chain
  # anchor match. A graceful restart is the available synchronization barrier:
  # wallet load and rescan finish before RPC readiness, and no call site has a
  # required mempool transaction at this point.
  local height_before_restart
  local height_after_restart
  node_cli getrawmempool >"$run_dir/${prefix}-mempool-before-node-sync.json" \
    || fail "could not inspect the mempool before the $prefix wallet synchronization restart"
  jq -e 'length == 0' "$run_dir/${prefix}-mempool-before-node-sync.json" >/dev/null \
    || fail "refusing to synchronize the node wallet with pending $prefix mempool transactions"
  if ! height_before_restart="$(node_cli getblockcount)"; then
    fail "could not read node height before the $prefix wallet synchronization restart"
  fi
  "${compose[@]}" restart junocashd >/dev/null \
    || fail "could not restart junocashd for $prefix wallet synchronization"
  wait_node || fail "junocashd did not recover after the $prefix wallet synchronization restart"
  wait_ready "$run_dir/${prefix}-ready-after-node-sync.json" \
    || fail "the appliance did not recover after the $prefix wallet synchronization restart"
  if ! height_after_restart="$(node_cli getblockcount)"; then
    fail "could not read node height after the $prefix wallet synchronization restart"
  fi
  jq -n \
    --argjson before "$height_before_restart" \
    --argjson after "$height_after_restart" \
    '{height_before:$before,height_after:$after}' \
    >"$run_dir/${prefix}-node-sync.json" \
    || fail "could not record the $prefix wallet synchronization evidence"
  [[ "$height_after_restart" == "$height_before_restart" ]] \
    || fail "node height changed across the $prefix wallet synchronization restart"

  local source_address=""
  local deadline=$((SECONDS + 180))
  while (( SECONDS < deadline )); do
    if node_cli listunspent 101 9999999 \
      >"$run_dir/${prefix}-source-unspent.json" 2>/dev/null; then
      source_address="$(jq -er \
        '[.[] | select(.generated == true and .spendable == true and .confirmations >= 101)]
          | first | .address | select(type == "string" and length > 0)' \
        "$run_dir/${prefix}-source-unspent.json" 2>/dev/null || true)"
      [[ -n "$source_address" ]] && break
    fi
    sleep 0.2
  done
  [[ -n "$source_address" ]] \
    || fail "no mature owned coinbase UTXO is available for $prefix"

  # Spend one mature coinbase UTXO directly to the exchange-owned Orchard
  # address. This creates a real deposit without depending on the pinned
  # node's wallet to spend a freshly received Orchard note.
  node_cli z_shieldcoinbase \
    "$source_address" \
    "$destination_address" \
    0.00015 \
    1 >"$run_dir/${prefix}-shield-request.json"
  local opid
  if ! opid="$(operation_id_from_file "$run_dir/${prefix}-shield-request.json")"; then
    fail "z_shieldcoinbase returned an invalid operation id"
  fi
  wait_operation "$opid" "$run_dir/${prefix}-shield-operation.json"
}

log "Build clean-source tools and appliance images"
GOWORK=off make -C "$workspace_root/juno-addrgen" build
make -C "$workspace_root/juno-keys" build
npm --prefix "$workspace_root/juno-exchange-sdk" run build
"$repo_root/scripts/check-clean-sources"
assert_source_refs

"$workspace_root/juno-keys/bin/juno-keys" seed new --out "$run_dir/hot.seed" >/dev/null
"$workspace_root/juno-keys/bin/juno-keys" --json ufvk from-seed \
  --seed-file "$run_dir/hot.seed" \
  --network regtest >"$run_dir/ufvk.json"
ufvk="$(jq -er '.data.ufvk' "$run_dir/ufvk.json")"
export JUNO_TXSIGN_SEED_FILE="$run_dir/hot.seed"
export JUNO_TXSIGN_BINDINGS_FILE="$run_dir/config/signer-bindings.json"
jq -n \
  --arg wallet "$wallet_id" \
  --arg ufvk "$ufvk" \
  '{version:"v1",bindings:[{wallet_id:$wallet,account:0,network:"regtest",ufvk:$ufvk}]}' \
  >"$JUNO_TXSIGN_BINDINGS_FILE"
chmod 0600 "$JUNO_TXSIGN_SEED_FILE" "$JUNO_TXSIGN_BINDINGS_FILE"

"$workspace_root/juno-keys/bin/juno-keys" seed new --out "$run_dir/cold.seed" >/dev/null
"$workspace_root/juno-keys/bin/juno-keys" --json ufvk from-seed \
  --seed-file "$run_dir/cold.seed" \
  --network regtest >"$run_dir/cold-ufvk.json"
cold_ufvk="$(jq -er '.data.ufvk' "$run_dir/cold-ufvk.json")"

# Use an address that is neither registered with the appliance nor imported
# into the node wallet when proving dropped-transaction expiry. A node-owned
# recipient is persisted in wallet.dat and reaccepted independently of
# -persistmempool=0 after restart.
"$workspace_root/juno-keys/bin/juno-keys" seed new --out "$run_dir/expiry-external.seed" >/dev/null
"$workspace_root/juno-keys/bin/juno-keys" --json ufvk from-seed \
  --seed-file "$run_dir/expiry-external.seed" \
  --network regtest >"$run_dir/expiry-external-ufvk.json"
expiry_external_ufvk="$(jq -er '.data.ufvk' "$run_dir/expiry-external-ufvk.json")"
"$workspace_root/juno-addrgen/bin/juno-addrgen" derive \
  --ufvk "$expiry_external_ufvk" \
  --index 0 \
  --json >"$run_dir/expiry-external-address.json"
expiry_destination_address="$(jq -er '.address' "$run_dir/expiry-external-address.json")"

jq -n \
  --arg wallet "$wallet_id" \
  --arg ufvk "$ufvk" \
  --arg cold_wallet "$cold_wallet_id" \
  --arg cold_ufvk "$cold_ufvk" \
  '{wallets:[{wallet_id:$wallet,ufvk:$ufvk,birthday_height:0,account:0},{wallet_id:$cold_wallet,ufvk:$cold_ufvk,birthday_height:0,account:0}]}' \
  >"$JUNO_GATEWAY_WALLETS_FILE"
jq -n \
  --arg read_token "$read_token" \
  --arg address_token "$address_token" \
  --arg broadcast_token "$broadcast_token" \
  --arg treasury_token "$treasury_token" \
  --arg coordinator_token "$coordinator_token" \
  --arg cold_wallet_token "$cold_wallet_token" \
  --arg wallet "$wallet_id" \
  --arg cold_wallet "$cold_wallet_id" \
  '{credentials:[
    {name:"exchange-read",token:$read_token,scopes:["read","raw","withdrawal"],wallets:[$wallet]},
    {name:"exchange-address",token:$address_token,scopes:["address"],wallets:[$wallet]},
    {name:"exchange-broadcast",token:$broadcast_token,scopes:["broadcast"],wallets:[$wallet]},
    {name:"exchange-treasury",token:$treasury_token,scopes:["treasury"],wallets:[$wallet]},
    {name:"exchange-coordinator",token:$coordinator_token,scopes:["plan"],wallets:[$wallet]},
    {name:"cold-wallet",token:$cold_wallet_token,scopes:["read","address","withdrawal"],wallets:[$cold_wallet]}
  ]}' \
  >"$JUNO_GATEWAY_AUTH_FILE"

"${compose[@]}" build
"$repo_root/scripts/check-clean-sources"
assert_source_refs

gateway_image_ref="$("${compose[@]}" config --format json | jq -er '.services.gateway.image')"
signer_image="$("${compose[@]}" config --format json | jq -er '.services.txsign.image')"
gateway_image_id="$(docker image inspect --format '{{.Id}}' "$gateway_image_ref")"
[[ -n "$gateway_image_id" ]] || fail "could not resolve the built gateway image"
gateway_runtime_uid="$(docker run --rm --entrypoint /usr/bin/id "$gateway_image_id" -u)"
gateway_runtime_gid="$(docker run --rm --entrypoint /usr/bin/id "$gateway_image_id" -g)"
[[ "$gateway_runtime_uid:$gateway_runtime_gid" == "10001:10001" ]] || \
  fail "gateway image must run as deterministic UID:GID 10001:10001"
if [[ "$(uname -s)" == "Linux" ]]; then
  docker run --rm --user 0:0 --entrypoint /bin/chown \
    --volume "$run_dir/config:/setup/config" \
    --volume "$JUNO_INSTALLATION_STATE_DIR:/setup/installation-state" \
    "$gateway_image_id" -R 10001:10001 /setup/config /setup/installation-state
fi
docker run --rm --read-only --entrypoint /bin/sh \
  --volume "$run_dir/config:/run/juno:ro" \
  --volume "$JUNO_INSTALLATION_STATE_DIR:/var/lib/juno-installation" \
  "$gateway_image_id" -ec \
  'test "$(id -u):$(id -g)" = "10001:10001"; test -r /run/juno/wallets.json; test -r /run/juno/auth.json; test -w /var/lib/juno-installation'

log "Installation guard: serve fails before one-time init"
if "${compose[@]}" run --no-deps --rm -T gateway >"$run_dir/serve-before-init.log" 2>&1; then
  fail "gateway served before installation init"
fi
grep -F 'installation manifest is missing' "$run_dir/serve-before-init.log" >/dev/null || \
  fail "pre-init serve did not report the missing installation manifest"

"${compose[@]}" run --no-deps --rm -T gateway init --acknowledge "$init_ack" \
  >"$run_dir/init.json"
assert_jq "$run_dir/init.json" \
  '.status == "initialized" and (.installation_id | test("^[0-9a-f]{64}$"))' \
  "one-time installation init returned invalid output"

if "${compose[@]}" run --no-deps --rm -T gateway init --acknowledge "$init_ack" \
  >"$run_dir/init-repeat.log" 2>&1; then
  fail "repeated installation init succeeded"
fi
grep -F 'one-time only' "$run_dir/init-repeat.log" >/dev/null || \
  fail "repeated init did not report the one-time guard"

export JUNO_GATEWAY_PORT="$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
export JUNO_COORDINATOR_PORT="$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
while [[ "$JUNO_COORDINATOR_PORT" == "$JUNO_GATEWAY_PORT" ]]; do
  export JUNO_COORDINATOR_PORT="$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
done
"${compose[@]}" up -d junocashd juno-scan gateway

for _ in $(seq 1 120); do
  published="$("${compose[@]}" port gateway 8080 2>/dev/null | head -n 1 || true)"
  if [[ -n "$published" ]]; then
    base_url="http://$published"
    break
  fi
  sleep 0.25
done
[[ -n "$base_url" ]] || fail "gateway did not publish its port"
for _ in $(seq 1 120); do
  published="$("${compose[@]}" port gateway 8081 2>/dev/null | head -n 1 || true)"
  if [[ -n "$published" ]]; then
    coordinator_url="http://$published"
    break
  fi
  sleep 0.25
done
[[ -n "$coordinator_url" ]] || fail "coordinator did not publish its private port"

wait_live
wait_ready "$run_dir/ready-initial.json"
wait_coordinator_ready "$run_dir/coordinator-ready-initial.json" \
  || fail "transaction coordinator did not become ready"
assert_jq "$run_dir/ready-initial.json" '.data.scanner.confirmations == 100' \
  "scanner and gateway confirmation policies differ"

log "Verify private topology and all three network configurations"
"$repo_root/scripts/check-compose"
for service in junocashd juno-scan; do
  container_id="$("${compose[@]}" ps -q "$service")"
  bindings="$(docker inspect -f '{{json .HostConfig.PortBindings}}' "$container_id")"
  [[ "$(jq -nr --argjson value "${bindings:-null}" '($value // {}) | length')" == "0" ]] || \
    fail "$service unexpectedly publishes a host port"
done
gateway_id="$("${compose[@]}" ps -q gateway)"
bindings="$(docker inspect -f '{{json .HostConfig.PortBindings}}' "$gateway_id")"
jq -enr --argjson value "$bindings" '
  ($value | keys | sort) == ["8080/tcp","8081/tcp"]
  and ($value["8080/tcp"] | length) == 1
  and ($value["8081/tcp"] | length) == 1
  and $value["8080/tcp"][0].HostIp == "127.0.0.1"
  and $value["8081/tcp"][0].HostIp == "127.0.0.1"
  and ($value["8080/tcp"][0].HostPort | test("^[0-9]+$"))
  and ($value["8081/tcp"][0].HostPort | test("^[0-9]+$"))
' >/dev/null || fail "gateway and coordinator must publish exactly two loopback host ports"
gateway_networks="$(docker inspect -f '{{json .NetworkSettings.Networks}}' "$gateway_id")"
jq -enr --argjson value "$gateway_networks" \
  --arg backend "${project}_backend" --arg ingress "${project}_ingress" \
  '$value | keys | sort == ([$backend,$ingress] | sort)' >/dev/null || \
  fail "gateway must join only backend and ingress networks"
backend_id="$(docker network inspect -f '{{.Id}}' "${project}_backend")"
[[ "$(docker network inspect -f '{{.Internal}}' "$backend_id")" == "true" ]] || \
  fail "gateway backend network must be internal"
ingress_id="$(docker network inspect -f '{{.Id}}' "${project}_ingress")"
[[ "$(docker network inspect -f '{{.Internal}}' "$ingress_id")" == "false" ]] || \
  fail "gateway ingress network must support the published host port"
ingress_options="$(docker network inspect -f '{{json .Options}}' "$ingress_id")"
jq -enr --argjson value "$ingress_options" '
  $value["com.docker.network.bridge.enable_ip_masquerade"] == "false"
  and $value["com.docker.network.bridge.enable_icc"] == "false"
' >/dev/null || fail "gateway ingress network must disable masquerading and inter-container communication"
scanner_id="$("${compose[@]}" ps -q juno-scan)"
scanner_networks="$(docker inspect -f '{{json .NetworkSettings.Networks}}' "$scanner_id")"
jq -enr --argjson value "$scanner_networks" \
  --arg backend "${project}_backend" --arg storage "${project}_storage" \
  '$value | keys | sort == ([$backend,$storage] | sort)' >/dev/null || \
  fail "scanner must join only backend and storage networks"
txsign_id="$("${compose[@]}" ps -q txsign)"
[[ -n "$txsign_id" ]] || fail "transaction signer container is missing"
[[ "$(docker inspect -f '{{.HostConfig.NetworkMode}}' "$txsign_id")" == "none" ]] || \
  fail "transaction signer must use Docker network_mode none"
txsign_bindings="$(docker inspect -f '{{json .HostConfig.PortBindings}}' "$txsign_id")"
[[ "$(jq -nr --argjson value "${txsign_bindings:-null}" '($value // {}) | length')" == "0" ]] || \
  fail "transaction signer unexpectedly publishes a host port"
txsign_pid_uid="$(docker exec "$txsign_id" awk '/^Uid:/{print $2; exit}' /proc/1/status)"
[[ "$txsign_pid_uid" == "10001" ]] || fail "transaction signer process must drop to UID 10001"

code="$(api_status GET /v1/version "$run_dir/version.json")"
[[ "$code" == "200" ]] || fail "version returned HTTP $code"
assert_jq "$run_dir/version.json" \
  --arg revision "$JUNO_GATEWAY_REVISION" \
  --arg scanner "$JUNO_SCAN_REF" \
  --arg addrgen "$JUNO_ADDRGEN_REF" \
  --arg txbuild "$JUNO_TXBUILD_REF" \
  --arg txsign "$JUNO_TXSIGN_REF" \
  '.data.network == "regtest"
    and .data.build.revision == $revision
    and .data.build.components["juno-scan"] == $scanner
    and .data.build.components["juno-addrgen"] == $addrgen
    and .data.build.components["juno-txbuild"] == $txbuild
    and .data.build.components["juno-txsign"] == $txsign
    and .data.build.components.junocashd == "v0.9.12"' \
  "version manifest is incomplete"

log "API boundary: chain tip, authentication, scopes, and wallet isolation"
code="$(coordinator_api_status GET /v1/health/ready "$run_dir/coordinator-auth-missing.json" "" "" "")"
[[ "$code" == "401" ]] || fail "coordinator missing authentication must return 401, got HTTP $code"
code="$(coordinator_api_status GET /v1/health/ready "$run_dir/coordinator-auth-scope.json" "" "" "$read_token")"
[[ "$code" == "403" ]] || fail "coordinator non-plan credential must return 403, got HTTP $code"
code="$(api_status GET /v1/network/tip "$run_dir/network-tip.json")"
