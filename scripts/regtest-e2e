  --argjson height "$post_expiry_height"
wait_note_status "$run_dir/expiry-note-status-request.json" "$run_dir/expiry-notes-unspent-after-expiry.json" \
  '.data.statuses | all(.state == "unspent")' \
  "selected notes did not return to unspent after strict expiry"
assert_no_deposit "$expiry_txid" "$run_dir/expiry-change-still-not-deposit.json"

