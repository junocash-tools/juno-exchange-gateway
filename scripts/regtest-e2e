if (( blocks_to_expiry > 0 )); then
  node_cli generate "$blocks_to_expiry" >"$run_dir/expiry-boundary-blocks.json"
fi
wait_ready "$run_dir/ready-at-expiry.json"
boundary_height="$(node_cli getblockcount | jq -er '.')"
[[ "$boundary_height" == "$expiry_height" ]] || fail "node did not stop at the exact transaction expiry height"
