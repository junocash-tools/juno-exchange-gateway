# Network: regtest, testnet, or mainnet.
JUNO_NETWORK=regtest

# Only the gateway is published. Bind to 0.0.0.0 only behind TLS/mTLS.
JUNO_GATEWAY_BIND=127.0.0.1
JUNO_GATEWAY_PORT=8080
JUNO_GATEWAY_WALLETS_FILE=./config/wallets.json
JUNO_GATEWAY_AUTH_FILE=./config/auth.json
# Keep this bind-mounted directory outside all Compose-managed data volumes.
# It contains no raw UFVK, seed, or key material, but it prevents address reuse.
JUNO_INSTALLATION_STATE_DIR=./installation-state
JUNO_GATEWAY_INSTALLATION_STATE=/var/lib/juno-installation/manifest.json

# The shipped RPC/scanner placeholders are accepted only on isolated regtest.
# Set strong, distinct values before testnet or mainnet startup.
JUNO_RPC_USER=juno-rpc
JUNO_RPC_PASSWORD=replace-this-regtest-rpc-password
JUNO_SCAN_API_BEARER_TOKEN=replace-this-internal-scanner-token
JUNO_NODE_PERSIST_MEMPOOL=1

# Financial-read policy.
JUNO_GATEWAY_DEFAULT_CONFIRMATIONS=100
JUNO_GATEWAY_MAX_CONFIRMATIONS=10000
JUNO_GATEWAY_MAX_SCANNER_LAG=2
JUNO_GATEWAY_REQUIRE_COMPLETE_HISTORY=true

# Request limits and timeouts.
JUNO_GATEWAY_MAX_JSON_BODY_BYTES=1048576
JUNO_GATEWAY_MAX_BROADCAST_BODY_BYTES=4194304
JUNO_GATEWAY_READ_TIMEOUT=15s
JUNO_GATEWAY_BROADCAST_TIMEOUT=30s
JUNO_GATEWAY_UPSTREAM_TIMEOUT=10s
JUNO_GATEWAY_SHUTDOWN_TIMEOUT=15s
JUNO_GATEWAY_HTTP_READ_HEADER_TIMEOUT=5s
JUNO_GATEWAY_HTTP_READ_TIMEOUT=30s
JUNO_GATEWAY_HTTP_WRITE_TIMEOUT=45s
JUNO_GATEWAY_HTTP_IDLE_TIMEOUT=60s
JUNO_GATEWAY_READ_RATE_RPS=50
JUNO_GATEWAY_READ_RATE_BURST=100
JUNO_GATEWAY_BROADCAST_RATE_RPS=2
JUNO_GATEWAY_BROADCAST_RATE_BURST=5
JUNO_GATEWAY_TRUST_PROXY_HEADERS=false
JUNO_GATEWAY_IDEMPOTENCY_LEASE=30s
JUNO_GATEWAY_BACKFILL_BATCH_SIZE=10000
JUNO_GATEWAY_BACKFILL_YIELD=250ms
JUNO_GATEWAY_BACKFILL_TIMEOUT=10m
JUNO_GATEWAY_WALLET_EFFECTS_MAX_EVENTS=10000
JUNO_GATEWAY_NOTE_SUMMARY_MAX_NOTES=100000

# Scanner defaults. RocksDB is the single-host mode; use compose.postgres.yaml
# for the recommended production Postgres mode.
JUNO_SCAN_CONFIRMATIONS=100
JUNO_SCAN_POLL_INTERVAL=2s
JUNO_SCAN_DB_DRIVER=rocksdb
JUNO_SCAN_MAX_READY_LAG=2
JUNO_SCAN_SHARD_CACHE_ENABLED=true
JUNO_SCAN_SHARD_CACHE_BATCH=4
JUNO_SCAN_SHARD_CACHE_POLL=5s
JUNO_SCAN_SHARD_CACHE_YIELD=25ms
JUNO_SCAN_WITNESS_MODE=auto

# Postgres override.
JUNO_POSTGRES_DB=junoscan
JUNO_POSTGRES_USER=junoscan
# Required when compose.postgres.yaml is used. Symbols are supported; the
# scanner receives this through PGPASSWORD rather than a connection URI.
JUNO_POSTGRES_PASSWORD=

# Production deployments should set immutable image references with digests.
JUNO_NODE_IMAGE=ghcr.io/junocash-tools/juno-exchange-gateway-node:main
JUNO_SCAN_IMAGE=ghcr.io/junocash-tools/juno-exchange-gateway-scanner:main
JUNO_GATEWAY_IMAGE=ghcr.io/junocash-tools/juno-exchange-gateway-gateway:main
JUNO_TXBUILD_IMAGE=ghcr.io/junocash-tools/juno-exchange-gateway-txbuild:main
JUNO_TXSIGN_IMAGE=ghcr.io/junocash-tools/juno-exchange-gateway-txsign:main
JUNO_POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777

# Local source-build identity. Release builds should override dev/local values.
JUNOCASH_VERSION=0.9.12
JUNOCASH_LINUX64_SHA256=41f74d61feb9a4284a4200b1fc163ecd072da3314a25db7222522f2e548ec386
JUNO_ADDRGEN_REF=4a2b3a361c7c1cc3e15891b0befb2eb3dfddb834
JUNO_SCAN_REF=3f6009fe16d15faa0da5a8962e0f5dad30307135
JUNO_TXBUILD_REF=40a185c38d8e0767fa5d98bf1967c7e64e544984
JUNO_TXSIGN_REF=1a32836f77f2d8a01ef0ef20842538cbc506f0c3
JUNO_TXSIGN_REPO=https://github.com/junocash-tools/juno-txsign.git
JUNO_GATEWAY_VERSION=dev
JUNO_GATEWAY_REVISION=local
JUNO_GATEWAY_BUILD_TIME=
